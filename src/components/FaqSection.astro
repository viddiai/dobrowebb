---
import { faq } from "../data/faq";
---

<section class="section wrap">
  <div class="center">
    <span class="eyebrow">Bra att veta innan vi börjar</span>
    <h2>Stora beslut. Raka svar.</h2>
  </div>
  <div class="faq">
    {faq.map((item, i) => (
      <details open={i === 0}>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
