---
// Före/efter-jämförelse: dra i handtaget (mus, touch) eller använd piltangenterna.
interface Props {
  before: string;
  after: string;
  /** Beskrivning av rummet, t.ex. "Marmorbadrum i Majorna". */
  label: string;
}

const { before, after, label } = Astro.props;
---

<div class="ba-slider" style="--pos:50%">
  <img
    class="ba-img"
    src={after}
    alt={`${label} efter renovering`}
    width="1200"
    height="900"
    fetchpriority="high"
  />
  <div class="ba-before">
    <img class="ba-img" src={before} alt={`${label} före renovering`} width="1200" height="900" />
  </div>
  <span class="ba-label ba-label-l" aria-hidden="true">
    Före
  </span>
  <span class="ba-label ba-label-r" aria-hidden="true">
    Efter
  </span>
  <div class="ba-handle" aria-hidden="true">
    <span class="ba-knob">
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 6l-6 6 6 6M15 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
  <input
    class="ba-range"
    type="range"
    min="0"
    max="100"
    value="50"
    step="0.5"
    aria-label="Jämför före och efter renovering"
    aria-valuetext="50 % före"
  />
</div>

<style>
  .ba-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 650px;
    margin-bottom: 50px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--light);
    user-select: none;
    -webkit-user-select: none;
  }
  .ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  .ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    box-shadow: 0 0 12px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .ba-label {
    position: absolute;
    top: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(20, 46, 55, 0.7);
    color: #fff;
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .ba-label-l {
    left: 16px;
  }
  .ba-label-r {
    right: 16px;
  }
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
    touch-action: pan-y;
  }
  .ba-slider:has(.ba-range:focus-visible) .ba-knob {
    outline: 3px solid #5c9532;
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .ba-slider:hover .ba-knob {
      transform: translate(-50%, -50%) scale(1.08);
    }
  }
  @media (max-width: 760px) {
    .ba-slider {
      aspect-ratio: 1.15;
      max-height: none;
      margin-bottom: 24px;
    }
    .ba-knob {
      width: 40px;
      height: 40px;
    }
    .ba-label {
      top: 10px;
      font-size: 0.7rem;
    }
    .ba-label-l {
      left: 10px;
    }
    .ba-label-r {
      right: 10px;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>(".ba-slider").forEach((slider) => {
    const range = slider.querySelector<HTMLInputElement>(".ba-range")!;
    const set = (value: number) => {
      slider.style.setProperty("--pos", `${value}%`);
      range.value = String(value);
      range.setAttribute("aria-valuetext", `${Math.round(value)} % före`);
    };
    let touched = false;
    range.addEventListener("input", () => {
      touched = true;
      set(Number(range.value));
    });

    // En kort "visa att det går att dra"-rörelse första gången slidern syns.
    if (reduced.matches || !("IntersectionObserver" in window)) return;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();
        const seq = [50, 35, 65, 50];
        let start: number | null = null;
        const step = (ts: number) => {
          // Avbryt om besökaren redan tagit över (drag eller tangentbord).
          if (touched) return;
          if (document.documentElement.classList.contains("keyboard-mode")) return set(50);
          start ??= ts;
          const p = Math.min((ts - start) / 1500, 1);
          const i = Math.min(Math.floor(p * 3), 2);
          const f = p * 3 - i;
          set(seq[i] + (seq[i + 1] - seq[i]) * (0.5 - Math.cos(f * Math.PI) / 2));
          if (p < 1) requestAnimationFrame(step);
        };
        setTimeout(() => requestAnimationFrame(step), 400);
      },
      { threshold: 0.5 },
    );
    observer.observe(slider);
  });
</script>
