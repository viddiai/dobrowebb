---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactSection from "../../components/ContactSection.astro";
---

<BaseLayout
  title="Om Dobro – 20+ år av renoveringar i Göteborg"
  description="Lär känna Dobro Byggkonsult från Mölnlycke. 500+ projekt, BKR-certifierade hantverkare och ett ansvar som fortsätter efter renoveringen."
>
  <div class="wrap breadcrumb">
    <a href="/">Hem</a> / Om oss
  </div>
  <section class="wrap hero subhero">
    <div>
      <span class="eyebrow">Om Dobro Byggkonsult</span>
      <h1>
        Förtroende byggs.
        <br /> <em>En detalj i taget.</em>
      </h1>
      <p class="intro">
        Vi är byggfirman från Mölnlycke som renoverat Göteborgshem i över 20 år. Från badrum till
        hela bostäder – med en projektledare som svarar och ansvar som fortsätter efter
        överlämningen.
      </p>
      <a class="button" href="/kontakt/">
        Boka kostnadsfritt hembesök
      </a>
    </div>
    <div class="heromedia">
      <img
        src="/assets/bathroom-detail.webp"
        alt="Omsorgsfullt utförda detaljer i ett av Dobros badrum"
        width="1200"
        height="900"
      />
      <span class="image-label">Hantverket sitter i detaljerna.</span>
    </div>
  </section>
  <div class="wrap stats">
    <div class="stat">
      <strong>
        4,9<span class="stars">★★★★★</span>
      </strong>
      <span>
        Kundbetyg på
        <br /> Google & Eniro
      </span>
    </div>
    <div class="stat">
      <strong>500+</strong>
      <span>
        Genomförda
        <br /> renoveringar
      </span>
    </div>
    <div class="stat">
      <strong>20+</strong>
      <span>
        År av erfarenhet
        <br /> i Göteborg
      </span>
    </div>
    <div class="stat">
      <strong>BKR</strong>
      <span>
        Certifierade
        <br /> våtrumshantverkare
      </span>
    </div>
  </div>
  <section class="section wrap">
    <div class="split">
      <div>
        <span class="eyebrow">Vårt sätt att arbeta</span>
        <h2>
          Ett gott samarbete
          <br /> ska märkas hemma.
        </h2>
      </div>
      <div>
        <p>
          Vi kan sekelskifteslägenheterna i Linné lika väl som villorna i Askim. Men inget hem är
          det andra likt. Därför börjar vi med att lyssna, planera och vara tydliga med
          förutsättningarna.
        </p>
        <div class="about-note">
          <h3>Kvalitet. Engagemang. Pålitlighet.</h3>
          <p>
            BKR-certifierade våtrumshantverkare, daglig städning och skriftligt godkännande före
            tillägg är konkreta delar av vårt ansvar.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="section portal">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Dobro Aftercare</span>
        <h2>
          Vi lämnar inte bara
          <br /> över nycklarna.
        </h2>
      </div>
      <div>
        <p>
          Ett färdigt projekt är början på ett fortsatt ansvar. Vi hör av oss efter 12 månader och
          stämmer av att allt fungerar som det ska.
        </p>
        <ul class="feature-list">
          <li>Skriftliga garantier vid överlämningen</li>
          <li>En kontakt du redan känner</li>
          <li>Digital husmapp som tillval – dokumentationen samlad</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Förtroende som förtjänas</span>
          <h2>
            Det finaste betyget?
            <br /> Att trivas hemma.
          </h2>
        </div>
        <p>
          <span class="stars">★★★★★</span>
          <br /> <strong>4,9 av 5</strong> på Google & Eniro
        </p>
      </div>
      <div class="quote-grid">
        <div class="quote">
          <span class="stars">★★★★★</span>
          <blockquote>
            ”Jag kan ha den minsta toaletten i Sverige, men det är numera mitt favoritrum i huset.”
          </blockquote>
          <cite>
            Susanne Särnholm<small>Recension på Google</small>
          </cite>
        </div>
        <div class="quote">
          <span class="stars">★★★★★</span>
          <blockquote>
            ”Plattsättaren jobbade snabbt, utan att tumma på kvalitet och precision. Supernöjd!”
          </blockquote>
          <cite>
            Ludmilla B.<small>Recension på Google</small>
          </cite>
        </div>
      </div>
    </div>
  </section>
  <ContactSection />
</BaseLayout>
