---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactSection from "../../components/ContactSection.astro";
---

<BaseLayout
  title="Renovering i Göteborg med omnejd"
  description="Dobro renoverar i Göteborg, Mölndal, Kungsbacka, Härryda, Lerum, Partille och Kungälv."
>
  <section class="wrap editorial-head">
    <span class="eyebrow">Nära ditt hem</span>
    <h1>
      Göteborg med omnejd.
      <br /> Samma omsorg överallt.
    </h1>
    <p>Vi utgår från Mölnlycke och hjälper dig med badrum, kök och hela hem i Göteborgsregionen.</p>
  </section>
  <section class="wrap section">
    <div class="area-grid">
      <div>
        <h2>Göteborg</h2>
        <p>Badrum, kök och renovering.</p>
        <a class="textlink" href="/kontakt/">
          Boka hembesök
        </a>
      </div>
      <div>
        <h2>Mölndal</h2>
        <p>Badrum, kök och renovering.</p>
        <a class="textlink" href="/kontakt/">
          Boka hembesök
        </a>
      </div>
      <div>
        <h2>Kungsbacka</h2>
        <p>Badrum, kök och renovering.</p>
        <a class="textlink" href="/kontakt/">
          Boka hembesök
        </a>
      </div>
      <div>
        <h2>Härryda & Mölnlycke</h2>
        <p>Badrum, kök och renovering.</p>
        <a class="textlink" href="/kontakt/">
          Boka hembesök
        </a>
      </div>
      <div>
        <h2>Lerum</h2>
        <p>Badrum, kök och renovering.</p>
        <a class="textlink" href="/kontakt/">
          Boka hembesök
        </a>
      </div>
      <div>
        <h2>Partille</h2>
        <p>Badrum, kök och renovering.</p>
        <a class="textlink" href="/kontakt/">
          Boka hembesök
        </a>
      </div>
      <div>
        <h2>Kungälv</h2>
        <p>Badrum, kök och renovering.</p>
        <a class="textlink" href="/kontakt/">
          Boka hembesök
        </a>
      </div>
    </div>
  </section>
  <ContactSection />
</BaseLayout>
