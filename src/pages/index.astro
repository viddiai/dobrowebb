---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactSection from "../components/ContactSection.astro";
---

<BaseLayout
  title="Badrumsrenovering Göteborg – 3–5 veckor & 10 års garanti"
  description="Badrum, kök och totalrenovering i Göteborg. Gratis hembesök, 3D-ritning och tydlig prisbild. BKR-certifierade hantverkare."
  faq
>
  <section class="wrap hero">
    <div>
      <span class="eyebrow">Renovering med omtanke · Göteborg</span>
      <h1>
        Drömbadrummet.
        <br />{" "}
        <em>
          Verklighet på
          <br /> 3–5 veckor.
        </em>
      </h1>
      <p class="minor">10 års garanti. En projektledare som svarar.</p>
      <p class="intro">
        Från första 3D-skissen till sista fogen. Vi tar hand om hela renoveringen – du får ett hem
        att trivas i och full koll längs vägen.
      </p>
      <a class="button" href="/kontakt/">
        Boka kostnadsfritt hembesök
      </a>
      <div class="checks">
        <span>Gratis hembesök & 3D-ritning</span>
        <span>Inte bindande</span>
      </div>
      <div class="hero-rating">
        <span class="stars">★★★★★</span>
        <span>
          <strong>4,9/5</strong> på Google & Eniro &nbsp; · &nbsp; 500+ projekt
        </span>
      </div>
    </div>
    <div class="heromedia">
      <img
        src="/assets/bathroom-hero.webp"
        alt="Dobros renoverade badrum med natursten, infällt badkar och svarta detaljer"
        width="1200"
        height="900"
        fetchpriority="high"
      />
      <div class="guarantee">
        <b>10 år</b>garanti på tätskikt
      </div>
      <span class="image-label">Ett riktigt Dobro-hem · Badrum i Göteborg</span>
    </div>
  </section>
  <div class="wrap stats">
    <div class="stat">
      <strong>
        4,9<span class="stars">★★★★★</span>
      </strong>
      <span>
        Kundbetyg på
        <br /> Google & Eniro
      </span>
    </div>
    <div class="stat">
      <strong>500+</strong>
      <span>
        Genomförda
        <br /> renoveringar
      </span>
    </div>
    <div class="stat">
      <strong>20+</strong>
      <span>
        År av erfarenhet
        <br /> i Göteborg
      </span>
    </div>
    <div class="stat">
      <strong>BKR</strong>
      <span>
        Certifierade
        <br /> våtrumshantverkare
      </span>
    </div>
  </div>
  <section class="section wrap" id="tjanster">
    <div class="section-head">
      <div>
        <span class="eyebrow">Ett team. Alla möjligheter.</span>
        <h2>
          För rummen du lever i.
          <br /> Och hemmet du drömmer om.
        </h2>
      </div>
      <p>
        Badrum är vår specialitet. Samma omsorg följer med i varje kök, varje rum och varje detalj.
      </p>
    </div>
    <div class="cards">
      <article class="card">
        <a href="/badrumsrenovering/" aria-label="Läs om badrumsrenovering">
          <div class="photo">
            <img
              src="/assets/bathroom-hero.webp"
              alt="Badrumsrenovering – detaljer från Dobros eget projekt"
              loading="lazy"
              width="800"
              height="650"
            />
          </div>
        </a>
        <div class="tag">Vår specialitet · 3–5 veckor</div>
        <h3>Ett badrum att längta hem till.</h3>
        <p>
          BKR-certifierade hantverkare, golvvärme som standard och 10 års garanti på tätskiktet.
        </p>
        <a class="textlink" href="/badrumsrenovering/">
          Upptäck badrumsrenovering
        </a>
      </article>
      <article class="card">
        <a href="/koksrenovering/" aria-label="Läs om köksrenovering">
          <div class="photo">
            <img
              src="/assets/kitchen.webp"
              alt="Köksrenovering – detaljer från Dobros eget projekt"
              loading="lazy"
              width="800"
              height="650"
            />
          </div>
        </a>
        <div class="tag">Hemmets hjärta · cirka 5 veckor</div>
        <h3>Mer plats för livet i köket.</h3>
        <p>
          Från första skiss till sista lampa. Vi tar hand om el, VVS och montering med 5 års garanti
          på arbetet.
        </p>
        <a class="textlink" href="/koksrenovering/">
          Upptäck köksrenovering
        </a>
      </article>
      <article class="card">
        <a href="/totalrenovering/" aria-label="Läs om totalrenovering">
          <div class="photo">
            <img
              src="/assets/bathroom-detail.webp"
              alt="Totalrenovering – detaljer från Dobros eget projekt"
              loading="lazy"
              width="800"
              height="650"
            />
          </div>
        </a>
        <div class="tag">Ett projekt · en kontaktperson</div>
        <h3>Hela hemmet. Ett enda team.</h3>
        <p>
          En projektledare samordnar hantverkare, tidplan och budget. Du får en röd tråd genom hela
          hemmet.
        </p>
        <a class="textlink" href="/totalrenovering/">
          Upptäck totalrenovering
        </a>
      </article>
    </div>
    <div class="extra-services">
      <a href="/snickeri-tillbyggnad/">
        Snickeri & tillbyggnad<small>Platsbyggt för ditt hem</small>
      </a>
      <a href="/maleri-fasadmalning/">
        Måleri & fasad<small>Ett hållbart första intryck</small>
      </a>
      <a href="/takbyte/">
        Takbyten<small>Trygghet från toppen</small>
      </a>
      <a href="/elinstallation/">
        Elinstallation<small>Från belysning till laddbox</small>
      </a>
    </div>
  </section>
  <section class="section portal">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Full insyn. Mindre oro.</span>
        <h2>
          Du ska kunna följa
          <br /> ditt projekt.
          <br /> Inte jaga det.
        </h2>
        <p class="lead">
          Vad händer härnäst? Hur ligger vi till? I din kundportal får du svaren utan att behöva
          ringa.
        </p>
        <ul class="feature-list">
          <li>Tidplan och uppdateringar direkt från arbetsplatsen</li>
          <li>Bilder, materialval och godkännanden på samma ställe</li>
          <li>Löpande kostnadsuppföljning – vi hör av oss i tid</li>
          <li>Digital husmapp med ritningar och intyg som tillval</li>
        </ul>
        <a class="button" style="margin-top:22px" href="/kundportal/">
          Mer om kundportalen
        </a>
      </div>
      <div class="portal-demo" aria-label="Illustrativ visning av kundportalen">
        <div class="demo-top">
          <strong>dobro</strong>
          <span>DITT PROJEKT</span>
        </div>
        <h3 class="demo-title">Ditt nya badrum</h3>
        <p>Överblick över renoveringen</p>
        <div class="progress-label">
          <span>Projektets framsteg</span>
          <strong>65 %</strong>
        </div>
        <div class="progress">
          <span></span>
        </div>
        <div class="demo-row">
          <span class="step-icon">✓</span>
          <div>
            Rivning & förberedelser<small>Klart och dokumenterat</small>
          </div>
        </div>
        <div class="demo-row">
          <span class="step-icon">✓</span>
          <div>
            VVS & eldragning<small>Kontrollerat av projektledaren</small>
          </div>
        </div>
        <div class="demo-row">
          <span class="step-icon">3</span>
          <div>
            Tätskikt & plattsättning<small>Pågående arbete</small>
          </div>
        </div>
        <div class="demo-row">
          <span class="step-icon">4</span>
          <div>
            Inredning & slutbesiktning<small>Nästa steg i din tidplan</small>
          </div>
        </div>
        <p class="demo-note">Exempel på projektöversikt i kundportalen.</p>
      </div>
    </div>
  </section>
  <section class="section wrap" id="process">
    <span class="eyebrow">En trygg väg hela vägen</span>
    <h2>Från första tanke till sista detalj.</h2>
    <div class="process">
      <div>
        <span class="num">01</span>
        <h3>Vi kommer hem till dig</h3>
        <p>
          Vi tar mått, lyssnar på dina idéer och går igenom förutsättningarna. Hembesöket är
          kostnadsfritt.
        </p>
      </div>
      <div>
        <span class="num">02</span>
        <h3>Du ser det framför dig</h3>
        <p>
          3D-ritning, materialval och en tydlig offert. Du vet vad vi planerar, hur lång tid det tar
          och vad det kostar.
        </p>
      </div>
      <div>
        <span class="num">03</span>
        <h3>Vi tar hand om jobbet</h3>
        <p>
          Din projektledare samordnar hantverkarna. Du följer arbetet i kundportalen och vi städar
          varje dag.
        </p>
      </div>
      <div>
        <span class="num">04</span>
        <h3>Tillsammans går vi igenom allt</h3>
        <p>
          Slutbesiktning, dokumentation och skriftliga garantier. Med Dobro Aftercare finns vi kvar
          även efteråt.
        </p>
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">Hantverk som syns</span>
        <h2>
          Detaljerna gör skillnaden.
          <br /> Helheten gör hemmet.
        </h2>
      </div>
      <a href="/projekt/" class="textlink">
        Se våra projekt
      </a>
    </div>
    <div class="project-wide">
      <img
        src="/assets/kitchen.webp"
        alt="Dobros färdiga kök med mörka ekluckor och ljus bänkskiva"
        loading="lazy"
        width="900"
        height="900"
      />
      <div>
        <span class="eyebrow">Köksrenovering · Göteborg</span>
        <h3>
          Mörk ek. Ljusa ytor.
          <br /> En självklar samlingsplats.
        </h3>
        <p>
          Platsbyggd känsla, integrerade vitvaror och genomtänkt belysning. Ett kök där funktion och
          material får lika stor omsorg.
        </p>
        <a class="textlink" href="/projekt/modernt-kok-villa-goteborg/">
          Utforska köket
        </a>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Förtroende som förtjänas</span>
          <h2>
            Det finaste betyget?
            <br /> Att trivas hemma.
          </h2>
        </div>
        <p>
          <span class="stars">★★★★★</span>
          <br /> <strong>4,9 av 5</strong> på Google & Eniro
        </p>
      </div>
      <div class="quote-grid">
        <div class="quote">
          <span class="stars">★★★★★</span>
          <blockquote>
            ”Jag kan ha den minsta toaletten i Sverige, men det är numera mitt favoritrum i huset.”
          </blockquote>
          <cite>
            Susanne Särnholm<small>Recension på Google</small>
          </cite>
        </div>
        <div class="quote">
          <span class="stars">★★★★★</span>
          <blockquote>
            ”Plattsättaren jobbade snabbt, utan att tumma på kvalitet och precision. Supernöjd!”
          </blockquote>
          <cite>
            Ludmilla B.<small>Recension på Google</small>
          </cite>
        </div>
      </div>
    </div>
  </section>
  <FaqSection />
  <ContactSection />
</BaseLayout>
