---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseCard from "../../components/CaseCard.astro";
import { getProjects, serviceByCategory, type Project } from "../../data/projekt";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      // Tre andra projekt i listans ordning.
      related: projects.filter((p) => p.id !== project.id).slice(0, 3),
    },
  }));
}

interface Props {
  project: Project;
  related: Project[];
}

const { project, related } = Astro.props;
const { title, description, category, place, weeks, image, quote } = project.data;
const service = serviceByCategory[category];
const { Content } = await render(project);
---

<BaseLayout title={`${title} – ${weeks} veckor`} description={description}>
  <div class="wrap breadcrumb">
    <a href="/">Hem</a> / <a href="/projekt/">Projekt</a> / {place}
  </div>
  <section class="wrap editorial-head">
    <span class="eyebrow">
      {category} · {place}
    </span>
    <h1>{title}</h1>
    <p>{description}</p>
  </section>
  <section class="wrap">
    {quote && (
      <>
        <blockquote class="case-quote">”{quote}”</blockquote>
        <p style="margin-bottom:35px">Kundens ord om projektet i {place}</p>
      </>
    )}
    <img
      class="case-cover"
      src={image}
      alt={`${title} – projektbild från Dobro`}
      width="1200"
      height="900"
    />
    <div class="project-facts">
      <div>
        <small>Projekt</small>
        <strong>{category}</strong>
      </div>
      <div>
        <small>Plats</small>
        <strong>{place}</strong>
      </div>
      <div>
        <small>Genomförande</small>
        <strong>{weeks} veckor</strong>
      </div>
    </div>
    <div class="split" style="padding-bottom:70px">
      <div>
        <span class="eyebrow">Resultatet</span>
        <h2>
          Planerat som en helhet.
          <br /> Utfört med omsorg.
        </h2>
      </div>
      <div>
        <Content />
        <p style="margin-top:24px">
          <a class="textlink" href={service.href}>
            Läs om {service.label}
          </a>
        </p>
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <span class="eyebrow">Ditt nästa steg</span>
      <h2>Vill du göra något liknande hemma?</h2>
      <p style="max-width:650px;margin:22px 0">
        Vi börjar med dina önskemål och bostadens förutsättningar. Tidplanen för varje nytt projekt
        fastställs i den egna offerten.
      </p>
      <a class="button" href="/kontakt/">
        Boka kostnadsfritt hembesök
      </a>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-head">
      <h2>Fler hem att inspireras av.</h2>
      <a class="textlink" href="/projekt/">
        Alla projekt
      </a>
    </div>
    <div class="cards">
      {related.map((p) => (
        <CaseCard project={p} />
      ))}
    </div>
  </section>
</BaseLayout>
