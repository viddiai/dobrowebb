# Kopiera till .env för lokal utveckling. Sätt de riktiga värdena i Vercel → Settings → Environment Variables.

# Delad nyckel för HMAC-signering av leads till Dobro Lead Hub (krävs för att formuläret ska fungera).
DOBRO_WEBHOOK_SECRET=

# Valfri: peka om leads till test/staging. Standard: https://www.dobro-leads.se/api/leads/inbound
DOBRO_LEADS_URL=
